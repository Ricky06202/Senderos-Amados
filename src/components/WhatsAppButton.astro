---
const phoneNumber = '50766714646'
const message =
  'Hola, vengo de la página web de Senderos Amados y me gustaría recibir más información.'
const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`
---

<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contáctanos por WhatsApp"
  class="fixed right-4 bottom-[max(1rem,env(safe-area-inset-bottom))] z-[60] inline-flex min-h-14 items-center gap-2.5 rounded-full bg-[#25D366] px-4 py-3 text-sm font-bold text-white shadow-[0_10px_30px_rgba(0,0,0,0.28)] transition duration-200 hover:-translate-y-0.5 hover:bg-[#20bd5a] hover:shadow-[0_14px_34px_rgba(0,0,0,0.32)] focus-visible:outline focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-yellow-300 sm:right-6"
>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    class="size-6 shrink-0 fill-current"
  >
    <path
      d="M20.52 3.48A11.85 11.85 0 0 0 12.05 0C5.49 0 .16 5.3.16 11.82c0 2.08.55 4.11 1.59 5.9L.06 24l6.46-1.68a11.92 11.92 0 0 0 5.52 1.4h.01C18.6 23.72 24 18.42 24 11.9c0-3.18-1.24-6.17-3.48-8.42ZM12.05 21.7h-.01a9.92 9.92 0 0 1-5.05-1.37l-.36-.21-3.84 1 1.03-3.72-.24-.38a9.73 9.73 0 0 1-1.5-5.2c0-5.45 4.47-9.89 9.98-9.89 2.66 0 5.17 1.04 7.05 2.91a9.8 9.8 0 0 1 2.91 7.02c0 5.46-4.48 9.84-9.97 9.84Zm5.48-7.4c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.27-.47-2.42-1.49a9.12 9.12 0 0 1-1.68-2.08c-.18-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47s1.07 2.86 1.22 3.06c.15.2 2.1 3.2 5.1 4.48.71.3 1.27.49 1.7.63.72.23 1.37.2 1.88.12.57-.08 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35Z"
    ></path>
  </svg>
  <span>Contáctame</span>
</a>

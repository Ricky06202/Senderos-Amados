---
import { Image } from 'astro:assets';
import logo from '../assets/Senderos Amados.png';
---

<header class="bg-green-800 text-white shadow-lg sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <a href="/" class="flex items-center gap-2">
        <Image src={logo} alt="Senderos Amados Logo" class="h-12 w-auto" />
        <span class="text-2xl font-serif font-bold tracking-wider hidden sm:block">
          Senderos Amados
        </span>
      </a>

      <nav class="hidden md:block">
        <div class="ml-10 flex items-baseline space-x-4">
          <a
            href="/#acerca"
            class="hover:bg-green-700 px-3 py-2 rounded-md text-sm font-medium"
            >Acerca</a
          >
          <a
            href="/#servicios"
            class="hover:bg-green-700 px-3 py-2 rounded-md text-sm font-medium"
            >Comodidades</a
          >
          <a
            href="/#ubicacion"
            class="hover:bg-green-700 px-3 py-2 rounded-md text-sm font-medium"
            >Ubicación</a
          >
          <a
            href="/productos"
            class="hover:bg-green-700 px-3 py-2 rounded-md text-sm font-medium"
            >Productos</a
          >
          <a
            href="/galeria"
            class="hover:bg-green-700 px-3 py-2 rounded-md text-sm font-medium"
            >Galería</a
          >
          <a
            href="/#disponibilidad"
            class="bg-yellow-400 text-green-900 hover:bg-yellow-300 px-4 py-2 rounded-full text-sm font-bold transition duration-300"
          >
            ¡Reserva Ahora!
          </a>
        </div>
      </nav>

      <button
        id="mobile-menu-button"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-controls="mobile-menu"
        aria-expanded="false"
        class="md:hidden min-h-11 min-w-11 text-white hover:text-yellow-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow-300"
      >
        <svg
          aria-hidden="true"
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16m-7 6h7"></path></svg
        >
      </button>
    </div>
  </div>

  <!-- Menú Móvil -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-green-900 px-2 pt-2 pb-3 space-y-1 sm:px-3 border-t border-green-700 text-center"
  >
    <div class="flex justify-center py-4">
      <Image src={logo} alt="Senderos Amados Logo" class="h-16 w-auto" />
    </div>
    <a
      href="/#acerca"
      class="block hover:bg-green-700 px-3 py-2 rounded-md text-base font-medium"
      >Acerca</a
    >
    <a
      href="/#servicios"
      class="block hover:bg-green-700 px-3 py-2 rounded-md text-base font-medium"
      >Comodidades</a
    >
    <a
      href="/#ubicacion"
      class="block hover:bg-green-700 px-3 py-2 rounded-md text-base font-medium"
      >Ubicación</a
    >
    <a
      href="/productos"
      class="block hover:bg-green-700 px-3 py-2 rounded-md text-base font-medium"
      >Productos</a
    >
    <a
      href="/galeria"
      class="block hover:bg-green-700 px-3 py-2 rounded-md text-base font-medium"
      >Galería</a
    >
    <a
      href="/#disponibilidad"
      class="block bg-yellow-400 text-green-900 hover:bg-yellow-300 px-3 py-2 rounded-md text-base font-bold transition duration-300 mt-4 text-center"
    >
      ¡Reserva Ahora!
    </a>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button')
  const menu = document.getElementById('mobile-menu')

  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden')
      const isExpanded = btn.getAttribute('aria-expanded') === 'true'
      btn.setAttribute('aria-expanded', String(!isExpanded))
      btn.setAttribute(
        'aria-label',
        isExpanded ? 'Abrir menú de navegación' : 'Cerrar menú de navegación',
      )
    })
  }
</script>
